# Local Development (Docker Compose)
APP_ENV=development
DATABASE_URL=postgres://mixtape:mixtape@postgres:5432/mixtape?sslmode=disable
PORT=8081

# Production (Vercel + Neon)
# APP_ENV=production
# DATABASE_URL=<neon-connection-string>
# PORT=<vercel-provided>

# Database Pool Settings (Keep low for Serverless/Containers)
DB_MAX_OPEN_CONNECTIONS=10
DB_MAX_IDLE_CONNECTIONS=2
DB_CONN_MAX_LIFETIME_MIN=15
DB_CONN_MAX_IDLE_TIME_MIN=5

# Secrets
ACCESS_TOKEN_SECRET=replace_with_secure_secret
REFRESH_TOKEN_SECRET=replace_with_secure_secret

# Security
CORS_ALLOWED_ORIGINS=http://localhost:3000
