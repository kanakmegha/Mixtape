FROM golang:alpine AS builder

WORKDIR /app

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ ./

RUN go build -o main ./cmd/api

FROM alpine:latest

WORKDIR /app

COPY --from=builder /app/main .

# Vercel will provide the PORT environment variable
# The application configuration already defaults to reading $PORT
# and listens on 0.0.0.0:$PORT

CMD ["./main"]
